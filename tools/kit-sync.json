{
  "sources": {
    "obsidian-kit": {
      "ref": "0.70.0"
    },
    "code-kit": {
      "ref": "0.37.5"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": ["anthropic-wire", "endpoint-secret-hook", "endpoint-source", "override-guard"],
      "rewrite": [["../vendor/code-kit/pure/", "./"], ["../vendor/code-kit/web/", "./"]]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "backend-probe",
        "capabilities",
        "diff",
        "embeddings-client",
        "endpoint",
        "endpoint_config",
        "endpoint_diagnostics",
        "error_body",
        "i18n",
        "json-error-position",
        "llm-answer",
        "model-choice",
        "model-context",
        "model-list-cache",
        "reasoning",
        "redact",
        "replace-span",
        "sampling-profiles",
        "secrets",
        "settings",
        "sse",
        "text-window",
        "think-splitter",
        "timeout"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/web",
      "modules": ["clipboard"]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": ["settings_walker", "folder-suggest", "collapsible", "help-setting"]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "anthropic-transport",
        "backend-probe",
        "chat-client",
        "chat-transport",
        "clipboard",
        "clock",
        "embedding-connection",
        "endpoint-list",
        "endpoint-plumbing",
        "endpoint-status-text",
        "endpoint-secrets",
        "endpoint-source",
        "llm-connection",
        "llm-connection-strings",
        "model-picker",
        "plugin-api",
        "request-section",
        "request-session",
        "secrets",
        "shortcuts-bridge"
      ],
      "rewrite": [
        ["../pure/", "../kit/"],
        ["../vendor/code-kit/pure/", "../kit/"],
        ["../vendor/code-kit/web/", "../kit/"]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": ["kit-css", "linear-probe"]
    }
  ]
}
