{
  // Test type-checking context, part of `npm run gate` (typecheck:test). It uses the REAL obsidian typings like the
  // build config does (an alias to the Vitest mock would hide type errors in src/ and invent mock-only members);
  // the mock stays a Vitest alias (vitest.config.ts). Tests that need mock-only helpers cast at the call site.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
